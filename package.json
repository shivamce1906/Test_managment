{
  "name": "glox-salon-backend",
  "version": "1.0.0",
  "description": "Glox Salon Management System Backend",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "tsx watch src/server.ts",
    "start:prod": "node dist/src/server.js",
    "dev:worker": "tsx watch src/worker.ts",
    "start:worker": "node dist/src/worker.js",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand --detectOpenHandles --forceExit",
    "test:coverage": "jest --coverage --runInBand --detectOpenHandles --forceExit"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/dotenv": "^6.1.1",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^20.17.0",
    "@types/pdfkit": "0.13.9",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "mongodb-memory-server": "^9.4.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "dependencies": {
    "bcrypt": "^5.1.1",
    "bullmq": "^5.25.6",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "dotenv": "^18.0.9",
    "exceljs": "^4.4.0",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "helmet": "^8.0.0",
    "ioredis": "^5.4.1",
    "ioredis-mock": "^8.9.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.7.2",
    "pdfkit": "0.15.2",
    "pino": "^9.5.0",
    "pino-pretty": "^11.3.0",
    "tsconfig-paths": "^4.2.0",
    "zod": "^3.23.8"
  }
}
