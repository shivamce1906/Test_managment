# Database (Normal Standalone MongoDB)
MONGODB_URI=mongodb://localhost:27017/glox_salon
# For Replica Set / Atlas cluster, uncomment:
# MONGODB_URI=mongodb://localhost:27017/glox_salon?replicaSet=rs0
REDIS_URL=redis://localhost:6379

# Authentication
JWT_SECRET=super-secret-jwt-key-min-32-chars-long-glox-salon-2026
JWT_ACCESS_TTL=15m
REFRESH_TTL_SUPERADMIN=12h
REFRESH_TTL_OWNER=30d
REFRESH_TTL_MANAGER=30d
REFRESH_TTL_BRANCH=7d

# Encryption (AWS KMS or local fallback)
KMS_KEY_ID=local-aes-256-gcm-master-key-32bytes-secret!

# AWS S3 Storage
S3_BUCKET=glox-salon-uploads
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=mock-access-key
AWS_SECRET_ACCESS_KEY=mock-secret-key

# AiSensy WhatsApp
AISENSY_BASE_URL=https://backend.aisensy.com
WEBHOOK_BASE_URL=http://localhost:4000/api/v1/webhooks

# Observability
SENTRY_DSN=
LOG_LEVEL=info

# Background Workers & Queue Execution
# Set to 'true' to run BullMQ workers directly inside the server process (ideal for single-instance, PaaS, or local dev)
RUN_EMBEDDED_WORKER=false

# Local Storage Directory (Used when AWS S3 credentials are mock or missing)
UPLOAD_DIR=./uploads

# App & CORS
PORT=4000
APP_ORIGINS=http://localhost:3000,http://localhost:5173,https://app.gloxsalon.com

